# Variables de entorno para conexión opcional con Supabase en SIREM (UIS)
# Si estas variables se dejan vacías, la aplicación opera automáticamente
# en modo autónomo con persistencia local (localStorage) y semilla determinista.
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-clave-publica-anon"
