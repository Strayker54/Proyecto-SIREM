# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — BACKEND / PYTHON (PROYECTO SIREM - UIS)
# ==============================================================================
# Copie este archivo como `.env` en la raíz del repositorio y pegue sus 3 claves
# obtenidas desde su proyecto de Supabase (Project Settings -> API).
#
# ADVERTENCIA DE SEGURIDAD:
# - `SUPABASE_SERVICE_ROLE_KEY` otorga acceso administrativo completo (omite RLS).
#   Úsela EXCLUSIVAMENTE aquí en el `.env` de la raíz para scripts de Python
#   (`python src/supabase_sync.py`) y JAMÁS la incluya en `frontend/.env`.
# ==============================================================================

# 1. URL del proyecto en Supabase
SUPABASE_URL="https://tu-proyecto.supabase.co"

# 2. Clave pública anónima (anon / public) — Segura con políticas RLS
SUPABASE_ANON_KEY="tu-clave-publica-anon"

# 3. Clave privada administrativa (service_role / secret) — EXCLUSIVA BACKEND PYTHON
SUPABASE_SERVICE_ROLE_KEY="tu-clave-privada-service-role-exclusiva-backend"
